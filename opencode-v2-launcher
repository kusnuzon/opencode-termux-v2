#!/@PREFIX@/bin/bash
# opencode-v2-launcher — OpenCode V2 launcher for Termux.
# Installed to $PREFIX/bin/opencode-v2 by install.sh (the shebang is rewritten to
# the Termux bash path because /usr/bin/env does not exist on Android).
#
# Launcher duties:
#   1. Run the V2 binary through the Termux glibc loader (the V2 binary needs
#      glibc, while Android uses bionic).
#   2. Keep the background service alive. V2 on Termux cannot spawn its own
#      service (process.execPath = loader path, not the real binary), so the
#      daemon is started here by the launcher.
#   3. Keep V2 state/data separate from OpenCode V1 (dedicated XDG_*).
set -uo pipefail

PREFIX="@PREFIX@"
APP="opencode-v2"
ROOT="$PREFIX/share/$APP"
REAL="$ROOT/opencode.real"
LOADER="$PREFIX/glibc/lib/ld-linux-aarch64.so.1"
GLIBC_LIB="$PREFIX/glibc/lib"
V2HOME="$HOME/.$APP"

if [ -f "$ROOT/lib/common.sh" ]; then
  # shellcheck source=/dev/null
  . "$ROOT/lib/common.sh"
fi

# Fallback when common.sh is not installed yet (e.g. half-finished install).
if ! command -v sanitize_glibc_env >/dev/null 2>&1; then
  sanitize_glibc_env() {
    unset LD_PRELOAD GLIBC_LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
    export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
  }
fi

export XDG_DATA_HOME="${XDG_DATA_HOME:-$V2HOME/data}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$V2HOME/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$V2HOME/cache}"
export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
export PATH="$PREFIX/bin:$PATH"
export TMPDIR="${TMPDIR:-$PREFIX/tmp}"

if [ ! -x "$REAL" ]; then
  printf '%s\n' "OpenCode V2 is not installed at $REAL" >&2
  printf '%s\n' "Run: curl -fsSL https://raw.githubusercontent.com/kusnuzon/opencode-termux-v2/main/install.sh | bash" >&2
  exit 1
fi
if [ ! -x "$LOADER" ]; then
  printf '%s\n' "Termux glibc runtime not found ($LOADER)" >&2
  printf '%s\n' "Run: pkg install glibc-repo glibc termux-exec-glibc" >&2
  exit 1
fi

# The V2 binary needs "libc.so", but Termux glibc only ships an ld script
# (a text file) -> the loader fails with "invalid ELF header". Shim built here.
if command -v ensure_compat_libs >/dev/null 2>&1; then
  ensure_compat_libs || printf '%s\n' "Failed to create the glibc library shim in $COMPAT_LIB" >&2
fi

run_client() {
  # Drop the bionic LD_PRELOAD from the interactive Termux shell before running
  # a glibc binary, otherwise the loader fails with "version `LIBC' not found".
  sanitize_glibc_env
  if command -v glibc_lib_path >/dev/null 2>&1; then
    exec "$LOADER" --library-path "$(glibc_lib_path)" "$REAL" "$@"
  fi
  exec "$LOADER" --library-path "$GLIBC_LIB" "$REAL" "$@"
}

service_status() {
  local pid url ver
  pid="$(daemon_pid 2>/dev/null || true)"
  url="$(daemon_url 2>/dev/null || true)"
  ver="$(daemon_version 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    printf 'service : running\n'
    printf 'pid     : %s\n' "$pid"
    printf 'url     : %s\n' "${url:-?}"
    printf 'version : %s\n' "${ver:-?}"
  else
    printf 'service : stopped\n'
  fi
}

# --- self-managed subcommands -----------------------------------------------
case "${1:-}" in
  service)
    sub="${2:-status}"
    case "$sub" in
      start)
        daemon_start
        exit $?
        ;;
      stop)
        daemon_stop
        printf 'service : stopped\n'
        exit 0
        ;;
      restart)
        daemon_stop
        daemon_start
        exit $?
        ;;
      status)
        service_status
        exit 0
        ;;
      *)
        # get/set/unset handled by V2 directly (no daemon needed).
        run_client "$@"
        exit $?
        ;;
    esac
    ;;
  doctor)
    if [ -f "$ROOT/doctor.sh" ]; then
      exec "$ROOT/doctor.sh" "$@"
    fi
    printf '%s\n' "doctor.sh is not installed in $ROOT" >&2
    exit 1
    ;;
  upgrade)
    # V2 has a built-in 'upgrade' command (npm/curl) that does not work on
    # Termux -> use our own script.
    shift
    if [ -f "$ROOT/upgrade.sh" ]; then
      exec "$ROOT/upgrade.sh" "$@"
    fi
    printf '%s\n' "upgrade.sh is not installed in $ROOT" >&2
    exit 1
    ;;
  uninstall)
    shift
    if [ -f "$ROOT/uninstall.sh" ]; then
      exec "$ROOT/uninstall.sh" "$@"
    fi
    printf '%s\n' "uninstall.sh is not installed in $ROOT" >&2
    exit 1
    ;;
esac

# --- commands that need the server ------------------------------------------
needs_server=1
case "${1:-}" in
  --version|-v|--help|-h|completions) needs_server=0 ;;
esac

if [ "$needs_server" -eq 1 ]; then
  if ! daemon_ensure; then
    printf '%s\n' "Failed to start the OpenCode V2 background service." >&2
    printf 'Log: %s\n' "$SERVER_LOG" >&2
    exit 1
  fi
fi

run_client "$@"
